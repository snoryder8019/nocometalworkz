<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — NoCo Metal Workz</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --orange: #f97316; --orange-dark: #c2410c; --orange-glow: rgba(249,115,22,0.15);
      --dark: #0d0d0d; --dark2: #141414; --dark3: #1c1c1c; --dark4: #252525;
      --border: rgba(255,255,255,0.08); --text: #e5e5e5; --muted: #888;
      --green: #22c55e; --red: #ef4444; --blue: #3b82f6;
      --font-display: 'Bebas Neue', sans-serif; --font: 'Inter', sans-serif;
      --r: 8px;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--dark); color: var(--text); font-family: var(--font); font-size: 15px; line-height: 1.6; display: flex; min-height: 100vh; }

    /* SIDEBAR */
    .sidebar {
      width: 240px; min-height: 100vh; background: var(--dark2);
      border-right: 1px solid var(--border); display: flex; flex-direction: column;
      position: sticky; top: 0; height: 100vh; overflow-y: auto; flex-shrink: 0;
    }
    .sb-logo { padding: 24px 20px; border-bottom: 1px solid var(--border); }
    .sb-logo-name { font-family: var(--font-display); font-size: 20px; color: #fff; letter-spacing: .05em; }
    .sb-logo-sub { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-top: 2px; }
    .sb-user { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
    .sb-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--dark4); overflow: hidden; flex-shrink: 0; }
    .sb-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .sb-uname { font-size: 13px; font-weight: 600; color: #fff; }
    .sb-uemail { font-size: 11px; color: var(--muted); }
    nav.sb-nav { padding: 12px 0; flex: 1; }
    .sb-nav a { display: flex; align-items: center; gap: 10px; padding: 10px 20px; font-size: 13px; font-weight: 500; color: var(--muted); text-decoration: none; transition: .2s; }
    .sb-nav a:hover, .sb-nav a.active { color: #fff; background: rgba(249,115,22,.08); border-left: 2px solid var(--orange); }
    .sb-nav a .nav-icon { font-size: 16px; width: 20px; text-align: center; }
    .sb-footer { padding: 16px 20px; border-top: 1px solid var(--border); }
    .sb-footer a { font-size: 12px; color: var(--muted); text-decoration: none; display: block; }
    .sb-footer a:hover { color: var(--red); }

    /* MAIN */
    .main { flex: 1; min-width: 0; }
    .topbar { background: var(--dark2); border-bottom: 1px solid var(--border); padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 10; }
    .topbar-title { font-family: var(--font-display); font-size: 22px; color: #fff; letter-spacing: .04em; }
    .topbar-right { display: flex; align-items: center; gap: 12px; }
    .badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
    .badge-green { background: rgba(34,197,94,.15); color: var(--green); }
    .badge-orange { background: var(--orange-glow); color: var(--orange); }

    .content { padding: 32px; display: flex; flex-direction: column; gap: 40px; }

    /* FLASH */
    .flash { padding: 12px 16px; border-radius: var(--r); font-size: 14px; font-weight: 500; margin-bottom: -24px; }
    .flash-success { background: rgba(34,197,94,.12); color: var(--green); border: 1px solid rgba(34,197,94,.25); }
    .flash-error { background: rgba(239,68,68,.12); color: var(--red); border: 1px solid rgba(239,68,68,.25); }

    /* SECTION CARDS */
    .card { background: var(--dark3); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    .card-header { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .card-title { font-family: var(--font-display); font-size: 20px; color: #fff; letter-spacing: .04em; }
    .card-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .card-body { padding: 24px; }

    /* STAT GRID */
    .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .stat-card { background: var(--dark3); border: 1px solid var(--border); border-radius: 10px; padding: 20px; }
    .stat-label { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: 8px; }
    .stat-num { font-family: var(--font-display); font-size: 40px; color: #fff; line-height: 1; letter-spacing: .02em; }
    .stat-num.orange { color: var(--orange); }
    .stat-num.green { color: var(--green); }
    .stat-num.blue { color: var(--blue); }
    .stat-sub { font-size: 11px; color: var(--muted); margin-top: 6px; }

    /* CHART */
    .chart-wrap { display: flex; align-items: flex-end; gap: 3px; height: 80px; padding: 0 4px; }
    .chart-bar { flex: 1; background: rgba(249,115,22,.25); border-radius: 3px 3px 0 0; min-height: 2px; transition: background .2s; position: relative; cursor: default; }
    .chart-bar:hover { background: var(--orange); }
    .chart-bar:hover::after {
      content: attr(data-count);
      position: absolute; bottom: calc(100% + 4px); left: 50%; transform: translateX(-50%);
      background: var(--dark4); color: #fff; font-size: 10px; padding: 2px 6px;
      border-radius: 4px; white-space: nowrap; pointer-events: none;
    }
    .chart-labels { display: flex; justify-content: space-between; padding: 6px 4px 0; }
    .chart-labels span { font-size: 10px; color: var(--muted); }

    /* FORM STYLES */
    .form-section { display: flex; flex-direction: column; gap: 16px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
    .fg { display: flex; flex-direction: column; gap: 6px; }
    .fg label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
    .fg input, .fg textarea, .fg select {
      background: var(--dark4); border: 1px solid var(--border); border-radius: var(--r);
      padding: 10px 14px; color: var(--text); font-family: var(--font); font-size: 14px;
      outline: none; transition: .2s; width: 100%;
    }
    .fg input:focus, .fg textarea:focus, .fg select:focus { border-color: var(--orange); box-shadow: 0 0 0 3px var(--orange-glow); }
    .fg textarea { resize: vertical; min-height: 80px; }
    .fg .hint { font-size: 11px; color: var(--muted); }
    .form-divider { height: 1px; background: var(--border); margin: 8px 0; }
    .service-block { background: var(--dark4); border: 1px solid var(--border); border-radius: var(--r); padding: 16px; }
    .service-block-title { font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 12px; }

    /* BUTTONS */
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border-radius: var(--r); font-family: var(--font); font-weight: 600; font-size: 13px; cursor: pointer; border: none; transition: .2s; text-decoration: none; }
    .btn-primary { background: var(--orange); color: #fff; }
    .btn-primary:hover { background: var(--orange-dark); }
    .btn-sm { padding: 6px 12px; font-size: 12px; }
    .btn-danger { background: rgba(239,68,68,.15); color: var(--red); border: 1px solid rgba(239,68,68,.2); }
    .btn-danger:hover { background: var(--red); color: #fff; }
    .btn-ghost { background: var(--dark4); color: var(--text); border: 1px solid var(--border); }
    .btn-ghost:hover { border-color: rgba(255,255,255,.2); color: #fff; }

    /* SUBMISSIONS TABLE */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    thead th { text-align: left; padding: 10px 14px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); border-bottom: 1px solid var(--border); }
    tbody td { padding: 12px 14px; border-bottom: 1px solid rgba(255,255,255,.04); vertical-align: top; }
    tbody tr:hover td { background: rgba(255,255,255,.02); }
    tbody tr.unread td { background: rgba(249,115,22,.04); }
    .td-name { font-weight: 600; color: #fff; }
    .td-meta { font-size: 11px; color: var(--muted); }
    .td-msg { max-width: 240px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--muted); }
    .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--orange); margin-right: 6px; }
    .td-actions { display: flex; gap: 6px; }
    .empty-state { text-align: center; padding: 40px; color: var(--muted); font-size: 14px; }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sb-logo">
      <div class="sb-logo-name">NoCo Metal Workz</div>
      <div class="sb-logo-sub">Admin Dashboard</div>
    </div>
    <div class="sb-user">
      <div class="sb-avatar">
        <% if (user.avatar) { %><img src="<%= user.avatar %>" alt="" /><% } %>
      </div>
      <div>
        <div class="sb-uname"><%= user.displayName %></div>
        <div class="sb-uemail"><%= user.email %></div>
      </div>
    </div>
    <nav class="sb-nav">
      <a href="#analytics" class="nav-icon-link"><span class="nav-icon">📊</span> Analytics</a>
      <a href="#submissions"><span class="nav-icon">📬</span> Submissions
        <% if (analytics.unreadSubmissions > 0) { %>
          <span class="badge badge-orange" style="margin-left:auto"><%= analytics.unreadSubmissions %></span>
        <% } %>
      </a>
      <a href="#company"><span class="nav-icon">🏢</span> Company Info</a>
      <a href="#hero"><span class="nav-icon">🖼️</span> Hero Section</a>
      <a href="#about"><span class="nav-icon">👷</span> About Section</a>
      <a href="#services"><span class="nav-icon">⚙️</span> Services</a>
      <a href="/" target="_blank"><span class="nav-icon">↗</span> View Site</a>
    </nav>
    <div class="sb-footer">
      <a href="/auth/logout">Sign Out</a>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main">
    <div class="topbar">
      <div class="topbar-title">Dashboard</div>
      <div class="topbar-right">
        <span class="badge badge-green">&#9679; Live</span>
        <span style="font-size:13px;color:var(--muted)"><%= new Date().toLocaleDateString('en-US', {weekday:'short', month:'short', day:'numeric'}) %></span>
      </div>
    </div>

    <div class="content">

      <!-- FLASH MESSAGES -->
      <% if (flash.success && flash.success.length) { %>
        <div class="flash flash-success">&#10003; <%= flash.success[0] %></div>
      <% } %>
      <% if (flash.error && flash.error.length) { %>
        <div class="flash flash-error">&#9888; <%= flash.error[0] %></div>
      <% } %>

      <!-- ANALYTICS -->
      <section id="analytics">
        <div class="stat-grid">
          <div class="stat-card">
            <div class="stat-label">Total Page Views</div>
            <div class="stat-num"><%= analytics.totalViews.toLocaleString() %></div>
            <div class="stat-sub">All time</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Views Today</div>
            <div class="stat-num orange"><%= analytics.todayViews %></div>
            <div class="stat-sub">Since midnight</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Views This Week</div>
            <div class="stat-num blue"><%= analytics.weekViews %></div>
            <div class="stat-sub">Last 7 days</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Form Submissions</div>
            <div class="stat-num green"><%= analytics.totalSubmissions %></div>
            <div class="stat-sub"><%= analytics.unreadSubmissions %> unread</div>
          </div>
        </div>

        <div class="card" style="margin-top:16px">
          <div class="card-header">
            <div>
              <div class="card-title">Page Views — Last 30 Days</div>
            </div>
          </div>
          <div class="card-body">
            <%
              const maxCount = Math.max(...analytics.chartData.map(d => d.count), 1);
            %>
            <div class="chart-wrap">
              <% analytics.chartData.forEach(function(d) { %>
                <div class="chart-bar"
                  style="height: <%= Math.max(2, Math.round((d.count / maxCount) * 80)) %>px"
                  data-count="<%= d.count %> views on <%= d.date %>"></div>
              <% }) %>
            </div>
            <div class="chart-labels">
              <span><%= analytics.chartData[0].date.slice(5) %></span>
              <span><%= analytics.chartData[14].date.slice(5) %></span>
              <span><%= analytics.chartData[29].date.slice(5) %></span>
            </div>
          </div>
        </div>
      </section>

      <!-- SUBMISSIONS -->
      <section id="submissions">
        <div class="card">
          <div class="card-header">
            <div>
              <div class="card-title">Contact Submissions</div>
              <div class="card-sub"><%= analytics.totalSubmissions %> total &bull; <%= analytics.unreadSubmissions %> unread</div>
            </div>
          </div>
          <div class="card-body" style="padding:0">
            <% if (recentSubmissions.length === 0) { %>
              <div class="empty-state">No submissions yet.</div>
            <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Contact</th>
                    <th>Service</th>
                    <th>Message</th>
                    <th>Date</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentSubmissions.forEach(function(s) { %>
                  <tr class="<%= !s.read ? 'unread' : '' %>">
                    <td>
                      <div class="td-name">
                        <% if (!s.read) { %><span class="dot"></span><% } %>
                        <%= s.name %>
                      </div>
                      <div class="td-meta"><%= s.email %></div>
                      <% if (s.phone) { %><div class="td-meta"><%= s.phone %></div><% } %>
                    </td>
                    <td><%= s.service || '—' %></td>
                    <td><div class="td-msg"><%= s.message || '—' %></div></td>
                    <td><div class="td-meta"><%= new Date(s.createdAt).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %></div></td>
                    <td>
                      <div class="td-actions">
                        <% if (!s.read) { %>
                        <form method="POST" action="/admin/submissions/<%= s._id %>/read">
                          <button type="submit" class="btn btn-ghost btn-sm">Mark Read</button>
                        </form>
                        <% } %>
                        <form method="POST" action="/admin/submissions/<%= s._id %>/delete" onsubmit="return confirm('Delete this submission?')">
                          <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>
          </div>
        </div>
      </section>

      <!-- COMPANY INFO -->
      <section id="company">
        <div class="card">
          <div class="card-header">
            <div>
              <div class="card-title">Company Info</div>
              <div class="card-sub">Name, tagline, and contact details shown across the site</div>
            </div>
          </div>
          <div class="card-body">
            <form method="POST" action="/admin/update/company" class="form-section">
              <div class="form-row">
                <div class="fg">
                  <label>Company Name</label>
                  <input type="text" name="company" value="<%= content.company %>" required />
                </div>
                <div class="fg">
                  <label>Tagline</label>
                  <input type="text" name="tagline" value="<%= content.tagline %>" />
                </div>
              </div>
              <div class="form-row">
                <div class="fg">
                  <label>Phone</label>
                  <input type="text" name="phone" value="<%= content.phone %>" />
                </div>
                <div class="fg">
                  <label>Email</label>
                  <input type="email" name="email" value="<%= content.email %>" />
                </div>
              </div>
              <div class="fg">
                <label>Service Area</label>
                <input type="text" name="serviceArea" value="<%= content.serviceArea %>" />
              </div>
              <div><button type="submit" class="btn btn-primary">Save Company Info</button></div>
            </form>
          </div>
        </div>
      </section>

      <!-- HERO SECTION -->
      <section id="hero">
        <div class="card">
          <div class="card-header">
            <div>
              <div class="card-title">Hero Section</div>
              <div class="card-sub">Main banner — title, subtitle, and stats</div>
            </div>
          </div>
          <div class="card-body">
            <form method="POST" action="/admin/update/hero" class="form-section">
              <div class="fg">
                <label>Eyebrow Text</label>
                <input type="text" name="eyebrow" value="<%= content.hero.eyebrow %>" />
              </div>
              <div class="fg">
                <label>Main Title</label>
                <input type="text" name="title" value="<%= content.hero.title %>" required />
              </div>
              <div class="fg">
                <label>Subtitle / Description</label>
                <textarea name="subtitle"><%= content.hero.subtitle %></textarea>
              </div>
              <div class="form-row">
                <div class="fg">
                  <label>Primary CTA Button</label>
                  <input type="text" name="ctaPrimary" value="<%= content.hero.ctaPrimary %>" />
                </div>
                <div class="fg">
                  <label>Secondary CTA Button</label>
                  <input type="text" name="ctaSecondary" value="<%= content.hero.ctaSecondary %>" />
                </div>
              </div>
              <div class="form-divider"></div>
              <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:4px">Stats Bar</div>
              <div class="form-row-3">
                <div class="fg">
                  <label>Stat 1 Number</label>
                  <input type="text" name="stat1Num" value="<%= content.hero.stat1Num %>" />
                </div>
                <div class="fg">
                  <label>Stat 1 Label</label>
                  <input type="text" name="stat1Label" value="<%= content.hero.stat1Label %>" />
                </div>
                <div></div>
                <div class="fg">
                  <label>Stat 2 Number</label>
                  <input type="text" name="stat2Num" value="<%= content.hero.stat2Num %>" />
                </div>
                <div class="fg">
                  <label>Stat 2 Label</label>
                  <input type="text" name="stat2Label" value="<%= content.hero.stat2Label %>" />
                </div>
                <div></div>
                <div class="fg">
                  <label>Stat 3 Number</label>
                  <input type="text" name="stat3Num" value="<%= content.hero.stat3Num %>" />
                </div>
                <div class="fg">
                  <label>Stat 3 Label</label>
                  <input type="text" name="stat3Label" value="<%= content.hero.stat3Label %>" />
                </div>
              </div>
              <div><button type="submit" class="btn btn-primary">Save Hero Section</button></div>
            </form>
          </div>
        </div>
      </section>

      <!-- ABOUT SECTION -->
      <section id="about">
        <div class="card">
          <div class="card-header">
            <div>
              <div class="card-title">About Section</div>
              <div class="card-sub">Company story, credentials, and badge</div>
            </div>
          </div>
          <div class="card-body">
            <form method="POST" action="/admin/update/about" class="form-section">
              <div class="form-row">
                <div class="fg">
                  <label>Eyebrow</label>
                  <input type="text" name="eyebrow" value="<%= content.about.eyebrow %>" />
                </div>
                <div class="fg">
                  <label>Section Title</label>
                  <input type="text" name="title" value="<%= content.about.title %>" required />
                </div>
              </div>
              <div class="fg">
                <label>Body Text</label>
                <textarea name="body" rows="4"><%= content.about.body %></textarea>
              </div>
              <div class="fg">
                <label>Credentials (one per line)</label>
                <textarea name="credentials" rows="4"><%= content.about.credentials.join('\n') %></textarea>
                <span class="hint">Each line becomes a checkmark bullet point</span>
              </div>
              <div class="form-row">
                <div class="fg">
                  <label>Badge Number</label>
                  <input type="text" name="yearsNum" value="<%= content.about.yearsNum %>" />
                </div>
                <div class="fg">
                  <label>Badge Label</label>
                  <input type="text" name="yearsLabel" value="<%= content.about.yearsLabel %>" />
                </div>
              </div>
              <div><button type="submit" class="btn btn-primary">Save About Section</button></div>
            </form>
          </div>
        </div>
      </section>

      <!-- SERVICES -->
      <section id="services">
        <div class="card">
          <div class="card-header">
            <div>
              <div class="card-title">Services</div>
              <div class="card-sub">Edit each service card displayed on the homepage</div>
            </div>
          </div>
          <div class="card-body">
            <form method="POST" action="/admin/update/services" class="form-section">
              <% content.services.forEach(function(s, i) { %>
              <div class="service-block">
                <div class="service-block-title">Service <%= i + 1 %></div>
                <div class="form-row">
                  <div class="fg">
                    <label>Icon (emoji)</label>
                    <input type="text" name="icon" value="<%= s.icon %>" />
                  </div>
                  <div class="fg">
                    <label>Service Name</label>
                    <input type="text" name="name" value="<%= s.name %>" required />
                  </div>
                </div>
                <div class="fg" style="margin-top:10px">
                  <label>Description</label>
                  <textarea name="desc" rows="2"><%= s.desc %></textarea>
                </div>
              </div>
              <% }) %>
              <div><button type="submit" class="btn btn-primary">Save Services</button></div>
            </form>
          </div>
        </div>
      </section>

    </div><!-- /content -->
  </main>

</body>
</html>
