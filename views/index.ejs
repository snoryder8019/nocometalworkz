<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner container">
      <a href="/" class="nav-logo">
        <img src="/images/nocometalworkz_logo_token.png" alt="<%= company %> logo" height="36" style="display:inline-block;vertical-align:middle;margin-right:8px;" />
        <img src="/images/nocometalworkz_logo_text.png" alt="<%= company %>" height="28" style="display:inline-block;vertical-align:middle;" />
      </a>
      <ul class="nav-links">
        <li><a href="#services">Services</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#work">Our Work</a></li>
        <li><a href="#contact" class="btn btn-outline">Get a Quote</a></li>
      </ul>
      <button class="nav-toggle" aria-label="Toggle menu">&#9776;</button>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <img class="hero-bg-img" src="/images/welder_background_high_res.png" alt="" />
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <p class="hero-eyebrow"><%= hero.eyebrow %></p>
      <h1 class="hero-title"><%= hero.title %></h1>
      <p class="hero-sub"><%= hero.subtitle %></p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary"><%= hero.ctaPrimary %></a>
        <a href="#work" class="btn btn-ghost"><%= hero.ctaSecondary %></a>
      </div>
      <div class="hero-stats">
        <div class="stat"><span class="stat-num"><%= hero.stat1Num %></span><span class="stat-label"><%= hero.stat1Label %></span></div>
        <div class="stat-divider"></div>
        <div class="stat"><span class="stat-num"><%= hero.stat2Num %></span><span class="stat-label"><%= hero.stat2Label %></span></div>
        <div class="stat-divider"></div>
        <div class="stat"><span class="stat-num"><%= hero.stat3Num %></span><span class="stat-label"><%= hero.stat3Label %></span></div>
      </div>
    </div>
    <div class="hero-scroll-hint">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="section services-section">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">What We Do</p>
        <h2 class="section-title">Built for Every Job</h2>
        <p class="section-sub">From a single gate to a full commercial fence line, we have the skills and equipment to handle it.</p>
      </div>
      <div class="services-grid">
        <% services.forEach(function(s) { %>
        <div class="service-card">
          <div class="service-icon"><%= s.icon %></div>
          <h3 class="service-name"><%= s.name %></h3>
          <p class="service-desc"><%= s.desc %></p>
          <a href="#contact" class="service-link">Request a Quote &rarr;</a>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ABOUT STRIP -->
  <section id="about" class="section about-section">
    <div class="container about-inner">
      <div class="about-text">
        <p class="section-eyebrow"><%= about.eyebrow %></p>
        <h2 class="section-title"><%= about.title %></h2>
        <p><%= about.body %></p>
        <ul class="about-list">
          <% about.credentials.forEach(function(c) { %>
          <li>&#10003; <%= c %></li>
          <% }) %>
        </ul>
        <a href="#contact" class="btn btn-primary">Talk to Us</a>
      </div>
      <div class="about-visual">
        <div class="about-box">
          <div class="spark spark1"></div>
          <div class="spark spark2"></div>
          <div class="spark spark3"></div>
          <img src="/images/pipeline.png" alt="Metalwork pipeline" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.45;border-radius:16px;" />
          <div class="about-badge">
            <span class="badge-num"><%= about.yearsNum %></span>
            <span class="badge-label"><%= about.yearsLabel %></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WORK GRID -->
  <section id="work" class="section work-section">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">Portfolio</p>
        <h2 class="section-title">Recent Projects</h2>
      </div>
      <div class="work-grid">
        <div class="work-item work-item--tall">
          <img class="work-placeholder" src="/images/intro/intro_Image_1708040155030.jpg" alt="Fencing & Automatic Gating" style="object-fit:cover;" />
          <div class="work-label">Fencing & Automatic Gating</div>
        </div>
        <div class="work-item">
          <img class="work-placeholder" src="/images/intro/intro_Image_1708207956112.jpg" alt="Residential Customs" style="object-fit:cover;" />
          <div class="work-label">Residential Customs</div>
        </div>
        <div class="work-item">
          <img class="work-placeholder" src="/images/intro/intro_Image_1708283734122.jpg" alt="Precision Laser Cutting" style="object-fit:cover;" />
          <div class="work-label">Precision Laser Cutting</div>
        </div>
        <div class="work-item">
          <img class="work-placeholder" src="/images/intro/intro_Image_1708284583078.jpg" alt="Custom Auto" style="object-fit:cover;" />
          <div class="work-label">Custom Auto</div>
        </div>
        <div class="work-item work-item--wide">
          <img class="work-placeholder" src="/images/intro/intro_Image_1708285028651.jpg" alt="Custom Auto Accessories" style="object-fit:cover;" />
          <div class="work-label">Custom Auto Accessories</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section contact-section">
    <div class="container contact-inner">
      <div class="contact-info">
        <p class="section-eyebrow">Let's Talk</p>
        <h2 class="section-title">Get a Free Quote</h2>
        <p>We'll come to your site, assess the job, and give you a straight number — no surprises.</p>
        <div class="contact-details">
          <div class="contact-item">
            <span class="ci-icon">&#128222;</span>
            <div>
              <strong>Phone</strong>
              <a href="tel:<%= phone %>"><%= phone %></a>
            </div>
          </div>
          <div class="contact-item">
            <span class="ci-icon">&#9993;</span>
            <div>
              <strong>Email</strong>
              <a href="mailto:<%= email %>"><%= email %></a>
            </div>
          </div>
          <div class="contact-item">
            <span class="ci-icon">&#128205;</span>
            <div>
              <strong>Service Area</strong>
              <span><%= serviceArea %></span>
            </div>
          </div>
        </div>
      </div>
      <form class="contact-form" action="/contact" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="John Smith" required />
          </div>
          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" placeholder="(970) 000-0000" />
          </div>
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required />
        </div>
        <div class="form-group">
          <label for="service">Service Needed</label>
          <select id="service" name="service">
            <option value="">Select a service...</option>
            <option>Custom Welding</option>
            <option>Fence Installation</option>
            <option>Metal Fabrication</option>
            <option>Wrought Iron Work</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">Project Details</label>
          <textarea id="message" name="message" rows="4" placeholder="Describe your project..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Send My Request</button>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <p class="footer-logo"><%= company %></p>
        <p class="footer-tagline"><%= tagline %></p>
      </div>
      <div class="footer-links">
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#work">Portfolio</a>
        <a href="#contact">Contact</a>
      </div>
      <div class="footer-qr">
        <div class="qr-wrap">
          <img id="qr-img" alt="Scan to share this page" width="68" height="68" />
        </div>
        <p>Scan to share</p>
      </div>
      <p class="footer-copy">&copy; <%= new Date().getFullYear() %> <%= company %>. All rights reserved.</p>
    </div>
  </footer>

  <script>
    // QR code — generate from current page URL
    (function() {
      var url = encodeURIComponent(window.location.href);
      document.getElementById('qr-img').src =
        'https://api.qrserver.com/v1/create-qr-code/?size=68x68&bgcolor=ffffff&color=0d0d0d&data=' + url;
    })();

    // Mobile nav toggle
    document.querySelector('.nav-toggle').addEventListener('click', function() {
      document.querySelector('.nav-links').classList.toggle('open');
    });

    // Smooth active state on scroll
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-links a[href^="#"]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          navLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('href') === '#' + entry.target.id);
          });
        }
      });
    }, { threshold: 0.4 });
    sections.forEach(s => observer.observe(s));
  </script>
</body>
</html>
